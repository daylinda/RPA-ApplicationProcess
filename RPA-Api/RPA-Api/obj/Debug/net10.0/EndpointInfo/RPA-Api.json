{
  "openapi": "3.0.4",
  "info": {
    "title": "RPA-Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Resume": {
      "get": {
        "tags": [
          "Resume"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeCollection"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeCollection"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeCollection"
                }
              }
            }
          }
        }
      }
    },
    "/api/Resume/upload": {
      "post": {
        "tags": [
          "Resume"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "File": {
                    "type": "string",
                    "format": "binary"
                  },
                  "UserId": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "File": {
                  "style": "form"
                },
                "UserId": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/User": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRecord"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRecord"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserRecord"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResumeCollection": {
        "type": "object",
        "properties": {
          "resumeRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumeRecord"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResumeRecord": {
        "type": "object",
        "properties": {
          "resumeId": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "fileName": {
            "type": "string",
            "nullable": true
          },
          "contentType": {
            "type": "string",
            "nullable": true
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "storagePath": {
            "type": "string",
            "nullable": true
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "createdUtc": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "UserRecord": {
        "required": [
          "email",
          "id",
          "name",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phoneNumber": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Resume"
    },
    {
      "name": "User"
    }
  ]
